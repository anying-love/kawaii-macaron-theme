  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#A79380"
      }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#A8763F"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "constant.language", "constant.character.escape"],
      "settings": {
        "foreground": "#C0784F"
      }
    },
    {
      "name": "Boolean & Null",
      "scope": ["constant.language.boolean", "constant.language.null"],
      "settings": {
        "foreground": "#C0784F"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#C2587F"
      }
    },
    {
      "name": "Function Name",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#B34A6E"
      }
    },
    {
      "name": "Type & Class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.type.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#A268B8"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": {
        "foreground": "#6B5A4C"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "variable.other.object.property", "variable.other.property"],
      "settings": {
        "foreground": "#8A6B5C"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#D05E85"
      }
    },
    {
      "name": "Attribute Name",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#B9763F"
      }
    },
    {
      "name": "Property",
      "scope": ["meta.object-literal.key", "support.variable.property", "variable.other.property.js"],
      "settings": {
        "foreground": "#8A5C7E"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.other", "constant.character", "constant.name"],
      "settings": {
        "foreground": "#C0784F"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": {
        "foreground": "#B9763F"
      }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading", "entity.name.section", "markup.heading.markdown"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#C4617F"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8A3D55"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8A5C6E"
      }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#8A7568"
      }
    },
    {
      "name": "Markup Link",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": {
        "foreground": "#B34A6E"
      }
    },
    {
      "name": "Markup List",
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#C2587F"
      }
    },
    {
      "name": "Decorator / Annotation",
      "scope": ["meta.decorator", "entity.name.function.decorator", "variable.annotation"],
      "settings": {
        "foreground": "#B268B8"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": ["support.type.property-name", "support.type.property-name.css", "meta.property-name"],
      "settings": {
        "foreground": "#8A5C7E"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"],
      "settings": {
        "foreground": "#A8763F"
      }
    },
    {
      "name": "CSS Class / Selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#D05E85"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#D4738B",
        "fontStyle": "underline"
      }
    }
  ]
}
